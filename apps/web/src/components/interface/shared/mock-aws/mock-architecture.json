                    { "name": "user_id", "type": "UUID", "fk": true },
                    { "name": "agent_id", "type": "VARCHAR(100)" }
                  ]
                }
              ]
            }
          },
          "workflows": [
            {
              "id": "wf-ai-support-escalation",
              "name": "AI Support Escalation",
              "description": "Escalate complex queries to human agents",
              "status": "active",
              "trigger": {
                "type": "event",
                "event": "ai.confidence_low",
                "source": "agent-orchestrator-lambda"
              },
              "steps": [
                {
                  "id": "step-1",
                  "type": "condition",
                  "name": "Check Confidence",
                  "condition": "response.confidence < 0.7",
                  "true_next": "step-2",
                  "false_next": "end"
                },
                {
                  "id": "step-2",
                  "type": "action",
                  "name": "Create Support Ticket",
                  "action": "api_call",
                  "integration": "Zendesk",
                  "config": { "priority": "high" }
                },
                {
                  "id": "step-3",
                  "type": "action",
                  "name": "Notify Support Team",
                  "action": "send_message",
                  "integration": "Slack",
                  "config": { "channel": "#support-escalations" }
                }
              ]
            },
            {
              "id": "wf-knowledge-base-update",
              "name": "Knowledge Base Update",
              "description": "Sync new documents to vector store",
              "status": "active",
              "trigger": {
                "type": "event",
                "event": "document.uploaded",
                "source": "s3-knowledge-base"
              },
              "steps": [
                {
                  "id": "step-1",
                  "type": "action",
                  "name": "Extract Text",
                  "action": "extract_text",
                  "integration": "Textract"
                },
                {
                  "id": "step-2",
                  "type": "action",
                  "name": "Generate Embeddings",
                  "action": "create_embeddings",
                  "integration": "Bedrock"
                },
                {
                  "id": "step-3",
                  "type": "action",
                  "name": "Index in OpenSearch",
                  "action": "index_document",
                  "integration": "OpenSearch"
                }
              ]
            }
          ],
