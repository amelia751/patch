                  "columns": [
                    { "name": "id", "type": "UUID", "pk": true },
                    { "name": "user_id", "type": "UUID", "fk": true },
                    { "name": "total_amount", "type": "DECIMAL(10,2)" }
                  ]
                },
                {
                  "logical_id": "agent_sessions_table",
                  "name": "agent_sessions",
