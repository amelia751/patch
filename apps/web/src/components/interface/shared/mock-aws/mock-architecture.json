                "label": "Product Service",
                "logical_id": "product_service",
                "description": "Product catalog management"
              },
              {
                "id": "order-lambda",
                "service": "Lambda",
                "label": "Order Service",
                "logical_id": "order_service",
                "description": "Order processing and fulfillment"
              },
              {
                "id": "agent-orchestrator-lambda",
                "service": "Lambda",
                "label": "AI Agent Core",
                "logical_id": "agent_orchestrator",
                "description": "Orchestrates AI agent interactions"
              },
              {
                "id": "bedrock",
                "service": "Bedrock",
                "label": "AWS Bedrock",
                "logical_id": "bedrock_service",
                "description": "Foundation models for AI conversations"
              },
              {
                "id": "opensearch",
                "service": "OpenSearch",
                "label": "Vector Store",
                "logical_id": "vector_store",
                "description": "Vector database for semantic search"
              },
              {
                "id": "cognito",
                "service": "Cognito",
                "label": "User Pool",
                "logical_id": "user_pool",
                "description": "User authentication and management"
              },
              {
                "id": "db-main",
                "service": "RDS",
                "label": "Main Database",
                "logical_id": "main_database",
                "description": "PostgreSQL primary relational store"
              },
              {
                "id": "s3-images",
                "service": "S3",
                "label": "Product Images",
                "logical_id": "product_images",
                "description": "Static asset storage for product images"
              },
              {
                "id": "s3-knowledge-base",
                "service": "S3",
                "label": "Knowledge Base",
                "logical_id": "knowledge_base",
                "description": "Document repository for AI agent knowledge"
              },
              {
                "id": "cloudwatch",
                "service": "CloudWatch",
                "label": "Monitoring",
                "logical_id": "monitoring",
                "description": "Logs and metrics collection"
              }
            ],
            "edges": [
              { "from": "api-gateway", "to": "auth-lambda", "label": "/auth/*" },
              { "from": "api-gateway", "to": "product-lambda", "label": "/products/*" },
              { "from": "api-gateway", "to": "order-lambda", "label": "/orders/*" },
              { "from": "api-gateway", "to": "agent-orchestrator-lambda", "label": "/chat/*" },
              { "from": "auth-lambda", "to": "cognito", "label": "JWT auth" },
              { "from": "auth-lambda", "to": "db-main", "label": "main.users", "database": "main-db", "tables": ["users"] },
              { "from": "product-lambda", "to": "db-main", "label": "main.products", "database": "main-db", "tables": ["products"] },
              { "from": "product-lambda", "to": "s3-images", "label": "images/*" },
              { "from": "order-lambda", "to": "db-main", "label": "main.orders", "database": "main-db", "tables": ["orders", "order_items"] },
              { "from": "agent-orchestrator-lambda", "to": "bedrock", "label": "invoke model" },
              { "from": "agent-orchestrator-lambda", "to": "opensearch", "label": "semantic search" },
              { "from": "agent-orchestrator-lambda", "to": "db-main", "label": "store sessions" },
              { "from": "s3-knowledge-base", "to": "opensearch", "label": "index documents" },
              { "from": "auth-lambda", "to": "cloudwatch", "label": "logs" },
              { "from": "product-lambda", "to": "cloudwatch", "label": "logs" },
              { "from": "order-lambda", "to": "cloudwatch", "label": "logs" },
              { "from": "agent-orchestrator-lambda", "to": "cloudwatch", "label": "logs" }
            ]
          },
          "api": {
            "roles": [
              {
                "name": "customer",
                "description": "Regular authenticated user",
                "permissions": [
                  { "resource": "products", "actions": ["read"], "scope": "all" },
                  { "resource": "orders", "actions": ["create", "read"], "scope": "own" },
                  { "resource": "ai_chat", "actions": ["create", "read"], "scope": "own" }
                ]
              },
              {
                "name": "admin",
                "description": "Full system access",
                "permissions": [
                  { "resource": "*", "actions": ["*"], "scope": "all" }
                ]
              }
            ],
            "routes": [
              {
                "method": "POST",
                "path": "/auth/register",
                "description": "Register a new user account",
                "handler_service": "auth_service",
                "handler_method": "register",
                "auth": { "required": false },
                "database_tables": ["users_table"]
              },
              {
                "method": "POST",
                "path": "/auth/login",
                "description": "Authenticate user and return JWT token",
                "handler_service": "auth_service",
                "handler_method": "login",
                "auth": { "required": false },
                "database_tables": ["users_table"]
              },
              {
                "method": "GET",
                "path": "/products",
                "description": "List all products with pagination",
                "handler_service": "product_service",
                "handler_method": "listProducts",
                "auth": { "required": false },
                "database_tables": ["products_table"]
              },
              {
                "method": "GET",
                "path": "/orders",
                "description": "List user's orders",
                "handler_service": "order_service",
                "handler_method": "listOrders",
                "auth": { "required": true, "roles": ["customer", "admin"] },
                "database_tables": ["orders_table"]
              },
              {
                "method": "POST",
                "path": "/ai/chat",
                "description": "Send message to AI agent and get response",
                "handler_service": "agent_orchestrator",
                "handler_method": "chat",
                "auth": { "required": true, "roles": ["customer", "admin"] },
                "database_tables": ["agent_sessions_table"]
              }
            ]
          },
          "database": {
            "engine": "PostgreSQL",
            "schema": {
              "tables": [
                {
                  "logical_id": "users_table",
                  "name": "users",
                  "description": "Stores user account information",
                  "columns": [
                    { "name": "id", "type": "UUID", "pk": true },
                    { "name": "email", "type": "VARCHAR(255)", "unique": true, "pii": true },
                    { "name": "username", "type": "VARCHAR(50)", "unique": true, "pii": true }
                  ]
                },
                {
                  "logical_id": "products_table",
                  "name": "products",
                  "description": "Product catalog",
                  "columns": [
                    { "name": "id", "type": "UUID", "pk": true },
                    { "name": "name", "type": "VARCHAR(255)" },
                    { "name": "price", "type": "DECIMAL(10,2)" }
                  ]
                },
                {
                  "logical_id": "orders_table",
                  "name": "orders",
