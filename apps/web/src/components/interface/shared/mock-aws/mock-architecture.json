      {
        "id": "v2",
        "label": "Add AI Assistant",
        "description": "Enhanced with AWS Bedrock AI agent for customer support",
        "created_at": "2025-01-15T09:00:00Z",
        "parent_version_id": "v1",
        "status": "draft",
        "design": {
          "architecture_type": "serverless",
          "cloud_provider": "aws",
          "graph": {
            "nodes": [
              {
                "id": "api-gateway",
                "service": "API Gateway",
                "label": "Main API",
                "logical_id": "main_api",
                "description": "RESTful API endpoint for client requests"
              },
              {
                "id": "auth-lambda",
