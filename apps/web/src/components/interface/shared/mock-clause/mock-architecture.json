{
  "project": {
    "id": "proj_clause_001",
    "name": "Clause",
    "description": "Backend API for legal document analysis with hybrid search (Elasticsearch + Vertex AI), document processing (Document AI), and multi-agent Q&A system",
    "created_at": "2026-02-01T12:00:00Z",
    "active_version_id": "v1",
    "cloud_provider": "gcp",
    "versions": [
      {
        "id": "v1",
        "label": "Production",
        "description": "Full-featured legal AI workbench on GCP with Elasticsearch and Vertex AI",
        "created_at": "2026-02-01T12:00:00Z",
        "parent_version_id": null,
        "status": "deployed",
        "design": {
          "architecture_type": "serverless",
          "cloud_provider": "gcp",
          "graph": {
            "nodes": [
              {
                "id": "load-balancer",
                "service": "Cloud Load Balancing",
                "label": "clause-lb-prod",
                "resource_name": "clause-lb-prod",
                "logical_id": "ClauseLoadBalancer",
                "description": "HTTPS load balancer for API and frontend routing",
                "config": {
                  "protocol": "HTTPS",
                  "port": 443,
                  "sslPolicy": "MODERN"
                }
              },
              {
                "id": "api-service",
                "service": "Cloud Run",
                "label": "clause-api",
                "resource_name": "clause-api",
                "logical_id": "ClauseApiService",
                "description": "FastAPI backend with document processing and search APIs",
                "config": {
                  "runtime": "python311",
                  "memory": "2Gi",
                  "cpu": "4",
                  "maxInstances": 20,
                  "minInstances": 2
                }
              },
              {
                "id": "document-ai",
                "service": "Document AI",
                "label": "clause-doc-processor",
                "resource_name": "clause-doc-processor",
                "logical_id": "ClauseDocumentAI",
                "description": "Document AI for OCR, form parsing, and entity extraction",
                "config": {
                  "processorType": "FORM_PARSER_PROCESSOR",
                  "enableOCR": true,
                  "languages": ["en", "de", "fr"]
                }
              },
              {
                "id": "vertex-ai",
                "service": "Vertex AI",
                "label": "clause-embeddings",
                "resource_name": "clause-embeddings",
                "logical_id": "ClauseVertexAI",
                "description": "Vertex AI Embeddings API (text-embedding-004)",
                "config": {
                  "embeddingModel": "text-embedding-004",
                  "dimensions": 768
                }
              },
              {
                "id": "gemini-agent",
                "service": "Vertex AI",
                "label": "clause-agent",
                "resource_name": "clause-agent",
                "logical_id": "ClauseGeminiAgent",
                "description": "Gemini 2.5 Pro Agent for document Q&A, summarization, and chat",
                "config": {
                  "model": "gemini-2.5-pro",
                  "maxTokens": 16384,
                  "temperature": 0.2,
                  "features": ["chat", "qa", "summarization", "citation", "reasoning"]
                }
              },
              {
                "id": "elasticsearch",
                "service": "Elastic Cloud",
                "label": "clause-search",
                "resource_name": "clause-search",
                "logical_id": "ClauseElasticsearch",
                "description": "Elasticsearch for hybrid search (BM25 + vector + RRF)",
                "config": {
                  "version": "8.11",
                  "tier": "Standard",
                  "vectorDimensions": 768,
                  "similarity": "cosine"
                }
              },
              {
                "id": "postgres",
                "service": "Cloud SQL",
                "label": "clause-db",
                "resource_name": "clause-db",
                "logical_id": "ClauseDatabase",
                "description": "PostgreSQL 15 for projects, vaults, and document metadata",
                "config": {
                  "engine": "postgres",
                  "version": "15",
                  "tier": "db-g1-small",
                  "diskSize": "50GB",
                  "backupEnabled": true,
                  "highAvailability": true
                }
              },
              {
                "id": "firestore",
                "service": "Firestore",
                "label": "clause-metadata",
                "resource_name": "clause-metadata",
                "logical_id": "ClauseFirestore",
                "description": "Firestore for document chunk metadata and real-time sync",
                "config": {
                  "mode": "native",
                  "location": "us-central1"
                }
              },
              {
                "id": "gcs-raw",
                "service": "Cloud Storage",
                "label": "clause-raw-documents",
                "resource_name": "clause-raw-documents",
                "logical_id": "ClauseRawBucket",
                "description": "Raw document storage (PDFs, DOCX, images)",
                "config": {
                  "storageClass": "STANDARD",
                  "versioning": true,
                  "lifecycle": { "deleteOlderThan": 365 }
                }
              },
              {
                "id": "gcs-processed",
                "service": "Cloud Storage",
                "label": "clause-processed",
                "resource_name": "clause-processed",
                "logical_id": "ClauseProcessedBucket",
                "description": "Processed documents and extracted text",
                "config": {
                  "storageClass": "STANDARD",
                  "versioning": false
                }
              },
              {
                "id": "pubsub",
                "service": "Pub/Sub",
                "label": "clause-events",
                "resource_name": "clause-events",
                "logical_id": "ClausePubSub",
                "description": "Event bus for async document processing pipeline",
                "config": {
                  "topics": ["document-uploaded", "processing-complete", "analysis-ready"],
                  "deadLetterPolicy": true
                }
              },
              {
                "id": "cloud-tasks",
                "service": "Cloud Tasks",
                "label": "clause-tasks",
                "resource_name": "clause-tasks",
                "logical_id": "ClauseCloudTasks",
                "description": "Task queue for batch document analysis",
                "config": {
                  "maxConcurrentDispatches": 10,
                  "maxDispatchesPerSecond": 5
                }
              },
              {
                "id": "cloud-logging",
                "service": "Cloud Logging",
                "label": "clause-logs",
                "resource_name": "clause-logs",
                "logical_id": "ClauseLogging",
                "description": "Centralized logging and monitoring",
                "config": {
                  "retention": 30
                }
              }
            ],
            "edges": [
              { "from": "load-balancer", "to": "api-service", "label": "/api/*" },
              { "from": "api-service", "to": "postgres", "label": "projects, vaults" },
              { "from": "api-service", "to": "gcs-raw", "label": "upload docs" },
              { "from": "api-service", "to": "pubsub", "label": "document-uploaded" },
              { "from": "pubsub", "to": "document-ai", "label": "trigger processing" },
              { "from": "document-ai", "to": "gcs-raw", "label": "read PDF" },
              { "from": "document-ai", "to": "gcs-processed", "label": "write text" },
              { "from": "document-ai", "to": "firestore", "label": "chunk metadata" },
              { "from": "document-ai", "to": "vertex-ai", "label": "get embeddings" },
              { "from": "vertex-ai", "to": "elasticsearch", "label": "index vectors" },
              { "from": "api-service", "to": "elasticsearch", "label": "hybrid search" },
              { "from": "api-service", "to": "gemini-agent", "label": "Q&A chat" },
              { "from": "gemini-agent", "to": "elasticsearch", "label": "RAG retrieval" },
              { "from": "api-service", "to": "firestore", "label": "doc metadata" },
              { "from": "api-service", "to": "cloud-tasks", "label": "batch analysis" },
              { "from": "cloud-tasks", "to": "api-service", "label": "process batch" },
              { "from": "api-service", "to": "cloud-logging", "label": "logs" }
            ]
          },
          "api": {
            "roles": [
              {
                "name": "user",
                "description": "Authenticated user with project access",
                "permissions": [
                  { "resource": "projects", "actions": ["create", "read", "update", "delete"], "scope": "own" },
                  { "resource": "documents", "actions": ["create", "read", "delete"], "scope": "own" },
                  { "resource": "search", "actions": ["read"], "scope": "own" }
                ]
              },
              {
                "name": "admin",
                "description": "Full system access",
                "permissions": [
                  { "resource": "*", "actions": ["*"], "scope": "all" }
                ]
              }
            ],
            "routes": [
              {
                "method": "POST",
                "path": "/api/upload",
                "description": "Upload document to vault for processing",
                "handler_service": "upload_service",
                "handler_method": "upload_document",
                "auth": { "required": true },
                "database_tables": ["documents", "vaults"],
                "services": ["Cloud Storage", "Pub/Sub"]
              },
              {
                "method": "POST",
                "path": "/api/batch-upload",
                "description": "Upload multiple documents at once",
                "handler_service": "upload_service",
                "handler_method": "batch_upload",
                "auth": { "required": true },
                "database_tables": ["documents"],
                "services": ["Cloud Storage", "Pub/Sub", "Cloud Tasks"]
              },
              {
                "method": "GET",
                "path": "/api/documents",
                "description": "List documents in a vault with pagination",
                "handler_service": "document_service",
                "handler_method": "list_documents",
                "auth": { "required": true },
                "database_tables": ["documents", "vaults"]
              },
              {
                "method": "GET",
                "path": "/api/documents/:id",
                "description": "Get document details and content",
                "handler_service": "document_service",
                "handler_method": "get_document",
                "auth": { "required": true },
                "database_tables": ["documents"],
                "services": ["Firestore", "Cloud Storage"]
              },
              {
                "method": "DELETE",
                "path": "/api/documents/:id",
                "description": "Delete document from vault",
                "handler_service": "document_service",
                "handler_method": "delete_document",
                "auth": { "required": true },
                "database_tables": ["documents"],
                "services": ["Cloud Storage", "Elasticsearch"]
              },
              {
                "method": "POST",
                "path": "/api/ask",
                "description": "Ask question with hybrid search and LLM response",
                "handler_service": "qa_service",
                "handler_method": "ask_question",
                "auth": { "required": true },
                "database_tables": ["documents"],
                "services": ["Elasticsearch", "Vertex AI"]
              },
              {
                "method": "POST",
                "path": "/api/qa/chat",
                "description": "Multi-turn conversation with context",
                "handler_service": "qa_service",
                "handler_method": "chat",
                "auth": { "required": true },
                "services": ["Elasticsearch", "Vertex AI", "Firestore"]
              },
              {
                "method": "POST",
                "path": "/api/table-analysis/batch",
                "description": "Batch analyze documents with custom columns",
                "handler_service": "table_analysis_service",
                "handler_method": "batch_analyze",
                "auth": { "required": true },
                "database_tables": ["documents", "document_analysis"],
                "services": ["Cloud Tasks", "Vertex AI"]
              },
              {
                "method": "GET",
                "path": "/api/table-analysis/status/:jobId",
                "description": "Get batch analysis job status",
                "handler_service": "table_analysis_service",
                "handler_method": "get_job_status",
                "auth": { "required": true },
                "database_tables": ["analysis_jobs"]
              },
              {
                "method": "GET",
                "path": "/api/search",
                "description": "Hybrid search across documents",
                "handler_service": "search_service",
                "handler_method": "search",
                "auth": { "required": true },
                "services": ["Elasticsearch", "Vertex AI"]
              }
            ]
          },
          "databases": [
            {
              "id": "primary",
              "engine": "Cloud SQL PostgreSQL",
              "instance_name": "clause-db",
              "version": "15",
              "rationale": "ACID transactions for projects, vaults, and document metadata",
              "schema": {
                "name": "clause",
                "tables": [
                  {
                    "logical_id": "projects_table",
                    "name": "projects",
                    "description": "Legal analysis projects/cases",
                    "columns": [
                      { "name": "id", "type": "VARCHAR(25)", "pk": true },
                      { "name": "title", "type": "VARCHAR(255)" },
                      { "name": "description", "type": "TEXT" },
                      { "name": "is_deleted", "type": "BOOLEAN", "default": "false" },
                      { "name": "tags", "type": "TEXT[]" },
                      { "name": "created_at", "type": "TIMESTAMPTZ", "default": "NOW()" },
                      { "name": "updated_at", "type": "TIMESTAMPTZ", "default": "NOW()" }
                    ]
                  },
                  {
                    "logical_id": "vaults_table",
                    "name": "vaults",
                    "description": "Document vaults (evidence folders)",
                    "columns": [
                      { "name": "id", "type": "VARCHAR(25)", "pk": true },
                      { "name": "project_id", "type": "VARCHAR(25)", "fk": true, "unique": true },
                      { "name": "name", "type": "VARCHAR(255)", "default": "'Evidence'" },
                      { "name": "created_at", "type": "TIMESTAMPTZ", "default": "NOW()" },
                      { "name": "updated_at", "type": "TIMESTAMPTZ", "default": "NOW()" }
                    ]
                  },
                  {
                    "logical_id": "folders_table",
                    "name": "folders",
                    "description": "Nested folder structure within vaults",
                    "columns": [
                      { "name": "id", "type": "VARCHAR(25)", "pk": true },
                      { "name": "vault_id", "type": "VARCHAR(25)", "fk": true },
                      { "name": "name", "type": "VARCHAR(255)" },
                      { "name": "path", "type": "VARCHAR(500)" },
                      { "name": "parent_folder_id", "type": "VARCHAR(25)", "fk": true },
                      { "name": "depth", "type": "INTEGER", "default": "0" },
                      { "name": "created_at", "type": "TIMESTAMPTZ", "default": "NOW()" }
                    ]
                  },
                  {
                    "logical_id": "documents_table",
                    "name": "documents",
                    "description": "Uploaded documents with processing status",
                    "columns": [
                      { "name": "id", "type": "VARCHAR(25)", "pk": true },
                      { "name": "vault_id", "type": "VARCHAR(25)", "fk": true },
                      { "name": "folder_id", "type": "VARCHAR(25)", "fk": true },
                      { "name": "name", "type": "VARCHAR(255)" },
                      { "name": "original_name", "type": "VARCHAR(255)" },
                      { "name": "gcs_path", "type": "VARCHAR(500)" },
                      { "name": "gcs_bucket", "type": "VARCHAR(100)" },
                      { "name": "mime_type", "type": "VARCHAR(100)" },
                      { "name": "size", "type": "BIGINT" },
                      { "name": "status", "type": "VARCHAR(20)", "default": "'pending'" },
                      { "name": "uploaded_at", "type": "TIMESTAMPTZ", "default": "NOW()" },
                      { "name": "processed_at", "type": "TIMESTAMPTZ" },
                      { "name": "firestore_doc_id", "type": "VARCHAR(100)" },
                      { "name": "elasticsearch_ids", "type": "TEXT[]" }
                    ]
                  },
                  {
                    "logical_id": "document_analysis_table",
                    "name": "document_analysis",
                    "description": "AI-extracted document metadata and custom columns",
                    "columns": [
                      { "name": "id", "type": "VARCHAR(25)", "pk": true },
                      { "name": "document_id", "type": "VARCHAR(25)", "fk": true, "unique": true },
                      { "name": "vault_id", "type": "VARCHAR(25)" },
                      { "name": "date", "type": "VARCHAR(50)" },
                      { "name": "document_type", "type": "VARCHAR(100)" },
                      { "name": "summary", "type": "TEXT" },
                      { "name": "author", "type": "VARCHAR(255)" },
                      { "name": "persons_mentioned", "type": "TEXT[]" },
                      { "name": "language", "type": "VARCHAR(10)" },
                      { "name": "custom_columns", "type": "JSONB", "default": "'{}'" },
                      { "name": "created_at", "type": "TIMESTAMPTZ", "default": "NOW()" }
                    ]
                  },
                  {
                    "logical_id": "analysis_jobs_table",
                    "name": "analysis_jobs",
                    "description": "Batch analysis job tracking",
                    "columns": [
                      { "name": "id", "type": "VARCHAR(25)", "pk": true },
                      { "name": "vault_id", "type": "VARCHAR(25)" },
                      { "name": "type", "type": "VARCHAR(50)" },
                      { "name": "template", "type": "VARCHAR(50)" },
                      { "name": "column_name", "type": "VARCHAR(100)" },
                      { "name": "question", "type": "TEXT" },
                      { "name": "status", "type": "VARCHAR(20)", "default": "'pending'" },
                      { "name": "progress", "type": "INTEGER", "default": "0" },
                      { "name": "total_docs", "type": "INTEGER" },
                      { "name": "processed_docs", "type": "INTEGER", "default": "0" },
                      { "name": "error", "type": "TEXT" },
                      { "name": "created_at", "type": "TIMESTAMPTZ", "default": "NOW()" },
                      { "name": "completed_at", "type": "TIMESTAMPTZ" }
                    ]
                  }
                ]
              }
            },
            {
              "id": "search",
              "engine": "Elasticsearch",
              "instance_name": "clause-search",
              "version": "8.11",
              "rationale": "Hybrid search with BM25, vector embeddings, and Reciprocal Rank Fusion",
              "indices": [
                {
                  "logical_id": "documents_index",
                  "name": "clause-documents",
                  "description": "Document chunks with text and vectors for hybrid search",
                  "mappings": {
                    "project_id": { "type": "keyword" },
                    "doc_id": { "type": "keyword" },
                    "chunk_id": { "type": "keyword" },
                    "doc_title": { "type": "text" },
                    "section_path": { "type": "text" },
                    "text": { "type": "text" },
                    "page": { "type": "integer" },
                    "vector": { "type": "dense_vector", "dims": 768, "similarity": "cosine" },
                    "tags": { "type": "keyword" },
                    "created_at": { "type": "date" }
                  }
                }
              ]
            },
            {
              "id": "metadata",
              "engine": "Firestore",
              "instance_name": "clause-metadata",
              "rationale": "Real-time document chunk metadata with bbox coordinates for highlighting",
              "collections": [
                {
                  "logical_id": "chunks_collection",
                  "name": "chunks",
                  "description": "Document chunks with bounding boxes for PDF highlighting",
                  "fields": [
                    { "name": "project_id", "type": "string" },
                    { "name": "doc_id", "type": "string" },
                    { "name": "chunk_id", "type": "string" },
                    { "name": "text", "type": "string" },
                    { "name": "page", "type": "number" },
                    { "name": "bbox_list", "type": "array" },
                    { "name": "created_at", "type": "timestamp" }
                  ]
                }
              ]
            }
          ],
          "risks": {
            "assumptions": [
              { "category": "Scale", "assumption": "Document uploads under 1000/day", "impact": "May need to increase Cloud Tasks concurrency" },
              { "category": "Cost", "assumption": "Elasticsearch self-managed on Elastic Cloud", "impact": "Consider reserved capacity for cost optimization" }
            ],
            "identifiedRisks": [
              { "risk": "Large PDF processing time", "severity": "medium", "mitigation": "Async processing with progress tracking" },
              { "risk": "Elasticsearch index size growth", "severity": "low", "mitigation": "Implement index lifecycle management" }
            ]
          }
        },
        "environments": {
          "dev": {
            "present_nodes": ["load-balancer", "api-service", "document-ai", "vertex-ai", "gemini-agent", "elasticsearch", "postgres", "firestore", "gcs-raw", "gcs-processed", "pubsub", "cloud-logging"],
            "overrides": {
              "api-service": { "minInstances": 0, "memory": "1Gi" },
              "postgres": { "tier": "db-f1-micro" }
            }
          },
          "staging": {
            "present_nodes": ["load-balancer", "api-service", "document-ai", "vertex-ai", "gemini-agent", "elasticsearch", "postgres", "firestore", "gcs-raw", "gcs-processed", "pubsub", "cloud-tasks", "cloud-logging"],
            "overrides": {
              "api-service": { "minInstances": 1 },
              "postgres": { "tier": "db-g1-small" }
            }
          },
          "prod": {
            "present_nodes": ["load-balancer", "api-service", "document-ai", "vertex-ai", "gemini-agent", "elasticsearch", "postgres", "firestore", "gcs-raw", "gcs-processed", "pubsub", "cloud-tasks", "cloud-logging"],
            "overrides": {
              "api-service": { "minInstances": 2, "maxInstances": 20 },
              "postgres": { "tier": "db-g1-small", "highAvailability": true }
            }
          }
        },
        "diff_from_parent": null
      }
    ]
  }
}
