# Pinned coordinates for the PatchAPI Agent Sandbox cluster.
#
# Every value here is read by scripts/verify_sandbox_gke.sh and by the manifest
# substitution it performs, so no cluster name, namespace, or image reference is
# inlined at a call site. Override any of them in the environment to point the
# same manifests at another cluster.

PATCHAPI_GKE_PROJECT="${PATCHAPI_GKE_PROJECT:-patch-505223}"
PATCHAPI_GKE_LOCATION="${PATCHAPI_GKE_LOCATION:-us-central1-a}"
PATCHAPI_GKE_CLUSTER="${PATCHAPI_GKE_CLUSTER:-patchapi-dev-agentsandbox}"

# Dev namespace. Sandbox objects are never created in default/kube-system so a
# namespace-scoped delete is a complete cleanup.
PATCHAPI_SANDBOX_NAMESPACE="${PATCHAPI_SANDBOX_NAMESPACE:-patchapi-sandbox-dev}"

# Artifact Registry repository holding the runner image. Deliberately not the
# repository infra/terraform creates (`patchapi-dev`), so a later terraform
# apply does not collide with a repository made by hand.
PATCHAPI_SANDBOX_IMAGE_REPO="${PATCHAPI_SANDBOX_IMAGE_REPO:-us-central1-docker.pkg.dev/patch-505223/patchapi-sandbox}"
PATCHAPI_SANDBOX_IMAGE_NAME="${PATCHAPI_SANDBOX_IMAGE_NAME:-sandbox-runner}"
PATCHAPI_SANDBOX_IMAGE_TAG="${PATCHAPI_SANDBOX_IMAGE_TAG:-dev}"

# DNS resolvers a sandbox is allowed to reach. NodeLocal DNSCache answers on the
# link-local address, so a policy that only selects the kube-dns pods leaves
# name resolution broken; both are allowed on port 53 and nothing else in
# 169.254.0.0/16 is reachable. Read from the cluster with:
#   kubectl get svc kube-dns -n kube-system -o jsonpath='{.spec.clusterIP}'
PATCHAPI_CLUSTER_DNS_IP="${PATCHAPI_CLUSTER_DNS_IP:-34.118.224.10}"
PATCHAPI_NODELOCAL_DNS_IP="${PATCHAPI_NODELOCAL_DNS_IP:-169.254.20.10}"

# GKE Agent Sandbox API groups, pinned so a group rename surfaces as a clear
# verifier failure rather than a silently skipped check.
PATCHAPI_SANDBOX_TEMPLATE_API="extensions.agents.x-k8s.io/v1alpha1"
PATCHAPI_SANDBOX_API="agents.x-k8s.io/v1alpha1"

# Minimum GKE version that ships the managed Agent Sandbox feature.
PATCHAPI_GKE_MIN_VERSION="1.35.2-gke.1269000"
