# Copy to .env (gitignored). Never commit real values.
# Secrets live under .secrets/ (gitignored).

GCP_PROJECT=patch-505223
GCP_REGION=us-central1
# Gemini 3.5 Flash / 3.1 Flash Image on Vertex use the global endpoint.
GCP_VERTEX_LOCATION=global

# Service account for Vertex + GCP (preferred for PatchAPI agents)
GOOGLE_APPLICATION_CREDENTIALS=.secrets/gcp-service-account.json

# Optional AI Studio key (Generative Language API). Currently credit-gated on this project.
# GOOGLE_API_KEY=   # or read from .secrets/gemini_api_key.txt

# Model pins (do not hardcode at call sites)
PATCHAPI_REASONING_MODEL=gemini-3.5-flash
PATCHAPI_IMAGE_MODEL=gemini-3.1-flash-image

# Demo fork (pinned in demo/egaki/baseline.json)
DEMO_FORK=amelia751/egaki
DEMO_FORK_SHA=c09e1a44200ff5e951746e013035e68aeb3a14b1

# Memory Bank / Agent Engine (created 2026-08-11; full name also in .secrets/memory_bank_name.txt)
# MEMORY_BANK_NAME=projects/913371146929/locations/us-central1/reasoningEngines/...

# --- Authoritative workflow state (constraint 7) -----------------------------
# Local and Cloud Run share Cloud SQL instance `patchapi-console`.
# Start the Auth Proxy, then load the DSN from gitignored secrets:
#   ./scripts/run_cloud_sql_proxy.sh
#   ./scripts/serve_control_api.sh
# DATABASE_URL is .secrets/database-url-proxy.txt (local) and Secret Manager
# patchapi-database-url (Cloud Run Unix socket). Do not paste it here.
#
# Docker Postgres (db/docker-compose.yml, 127.0.0.1:55432) is only for
# offline verify_db.sh, not day-to-day sign-in.
# DATABASE_URL=postgresql://patchapi:patchapi_local_dev@127.0.0.1:55432/patchapi

# --- Control plane -----------------------------------------------------------
# Browser origins allowed to call the control plane. Empty means none; the
# dashboard reads server-side, so this stays empty unless a browser must call
# the API directly.
PATCHAPI_CORS_ORIGINS=http://localhost:3000
# Reported by the health probes.
PATCHAPI_ENV=local
# Cloud Run job the console starts on "Start remediation". serve_control_api.sh
# defaults this; leave it unset and the button writes a FAILED row immediately.
PATCHAPI_REMEDIATION_JOB=patchapi-remediate

# --- Dashboard (apps/web) ----------------------------------------------------
# Where the dashboard's server-side reads go. Set in apps/web/.env.local.
PATCHAPI_API_URL=http://127.0.0.1:8080

# Identity Platform (client SDK). Real values live in
# .secrets/identity-platform.json — never commit them.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=patch-505223.firebaseapp.com

# --- Identity Platform (control plane) ---------------------------------------
# The same Web API key the browser uses. Unset here, packages/auth falls back to
# .secrets/identity_platform_api_key.txt, then to .secrets/identity-platform.json.
# PATCHAPI_IDENTITY_API_KEY=
# PATCHAPI_IDENTITY_API_KEY_FILE=.secrets/identity_platform_api_key.txt
# PATCHAPI_IDENTITY_CONFIG=.secrets/identity-platform.json
# Where Google's verification and reset emails send the browser back to. The
# host must also be an authorized domain on the project.
PATCHAPI_IDENTITY_ACTION_URL=http://localhost:3000/auth/action

# Admin-only Identity Platform calls (create_oauth_user, sign_out) authenticate
# as the service account above, not with the API key.

# Google sign-in (Continue with Google). Create a Web OAuth client in the Cloud
# Console — Google will not let a service account mint one on a no-org project —
# then put the id and secret here (gitignored):
# .secrets/google-oauth.json  {"client_id":"...","client_secret":"..."}
# PATCHAPI_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# PATCHAPI_FRONTEND_ORIGIN=http://localhost:3000
# Set on Cloud Run (HTTPS, dashboard and API on different run.app hosts):
# PATCHAPI_COOKIE_SECURE=1

# --- Repo indexer -------------------------------------------------------------
# PATCHAPI_INDEX_BACKEND=zoekt
# PATCHAPI_ZOEKT_INDEX_DIR=/tmp/patchapi-zoekt
# PATCHAPI_ZOEKT_WEBSERVER_URL=http://127.0.0.1:6070
# PATCHAPI_INDEXER_WORKDIR=/tmp/patchapi-index-work
# PATCHAPI_PUBSUB_TOPIC_PREFIX=patchapi-dev
# Reserved by scripts/bootstrap_cloud_run.sh. Do not rename the services.
# Prefer the predictable URL (name + project number + region). The classic
# *.a.run.app alias is the same service.
# PATCHAPI_FRONTEND_ORIGIN=https://patchapi-web-913371146929.us-central1.run.app
# PATCHAPI_CORS_ORIGINS=https://patchapi-web-913371146929.us-central1.run.app
# PATCHAPI_GOOGLE_OAUTH_REDIRECT_URI=https://patchapi-api-913371146929.us-central1.run.app/api/auth/google/callback
# NEXT_PUBLIC_API_URL=https://patchapi-api-913371146929.us-central1.run.app
# PATCHAPI_API_URL=https://patchapi-api-913371146929.us-central1.run.app

# --- GitHub App (OAuth login + repo import; one App, not a separate OAuth App)
# Create at https://github.com/settings/apps/new using the URLs in README.md.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=patchapi
# GITHUB_APP_PRIVATE_KEY_PATH=.secrets/github-app.pem
# PATCHAPI_GITHUB_OAUTH_CLIENT_ID=
# PATCHAPI_GITHUB_OAUTH_CLIENT_SECRET=
# PATCHAPI_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
# Narrow GitHub tool service (PR publisher). Local: ./scripts/run_github_tools.sh
# PATCHAPI_GITHUB_TOOLS_URL=http://127.0.0.1:8081
# HMAC for POST /v1/github/webhooks. Local file is .secrets/github-webhook-secret.txt.
# PATCHAPI_GITHUB_WEBHOOK_SECRET=
# Cloud Run:
# PATCHAPI_GITHUB_OAUTH_REDIRECT_URI=https://patchapi-api-913371146929.us-central1.run.app/api/auth/github/callback
